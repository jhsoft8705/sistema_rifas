# api/.htaccess PRODUCCIÓN - DOMINIO
# Destino: jhsoftperu.com
# Ruta API: https://jhsoftperu.com/api/
#
# INSTRUCCIONES: Renombrar a .htaccess y colocar dentro de la carpeta api/

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [QSA,L]
</IfModule>
