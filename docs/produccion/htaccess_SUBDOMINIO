#
# INSTRUCCIONES: Renombrar a .htaccess y colocar en la raíz del proyecto

RewriteEngine On
RewriteBase /

# Bloquear acceso directo a la carpeta web/ y router.php
RewriteCond %{THE_REQUEST} \s/+web/ [NC]
RewriteRule ^ - [F,L]
RewriteCond %{THE_REQUEST} \s/+web/router\.php [NC]
RewriteRule ^ - [F,L]

# Redirigir /api/* a api/index.php (la API tiene su propio .htaccess)
RewriteRule ^api/(.*)$ api/index.php [QSA,L]

# Redirigir todo lo demás a web/router.php excepto archivos y carpetas existentes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ web/router.php?url=$1 [QSA,L]

# Protección de archivos sensibles
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|env)$">
    Require all denied
</FilesMatch>

# Prevenir listado de directorios
Options -Indexes
